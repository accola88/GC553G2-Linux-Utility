+static int decode_failure(struct v4l2_decoder *decoder)
+{
+	/* Some drivers accept initialization but reject the stream's JPEG variant. */
+	if (decoder->using_hardware && ++decoder->consecutive_errors >= 8) {
+		blog(LOG_WARNING, "MJPEG hardware decode failed repeatedly; falling back to software");
+		av_frame_unref(decoder->frame);
+		av_frame_unref(decoder->software_frame);
+		avcodec_free_context(&decoder->context);
+		if (open_software_decoder(decoder, V4L2_PIX_FMT_MJPEG) < 0)
+			return -1;
+		decoder->consecutive_errors = 0;
+		return 1;
+	}
+	return -1;
+}
