+struct hardware_backend {
+	int mode;
+	const char *codec_name;
+	enum AVHWDeviceType device_type;
+	enum AVPixelFormat pixel_format;
+};
+
+static const struct hardware_backend hardware_backends[] = {
+	{V4L2_MJPEG_CUDA, "mjpeg_cuvid", AV_HWDEVICE_TYPE_CUDA, AV_PIX_FMT_CUDA},
+	{V4L2_MJPEG_VAAPI, "mjpeg", AV_HWDEVICE_TYPE_VAAPI, AV_PIX_FMT_VAAPI},
+	{V4L2_MJPEG_QSV, "mjpeg_qsv", AV_HWDEVICE_TYPE_QSV, AV_PIX_FMT_QSV},
+};
+
+static enum AVPixelFormat hardware_format(AVCodecContext *context, const enum AVPixelFormat *formats)
+{
+	struct v4l2_decoder *decoder = context->opaque;
+	for (const enum AVPixelFormat *format = formats; *format != AV_PIX_FMT_NONE; ++format)
+		if (*format == decoder->hardware_format)
+			return *format;
+	return AV_PIX_FMT_NONE;
+}
+
+static int open_software_decoder(struct v4l2_decoder *decoder, int pixfmt)
+{
+	decoder->codec = avcodec_find_decoder(pixfmt == V4L2_PIX_FMT_MJPEG ? AV_CODEC_ID_MJPEG : AV_CODEC_ID_H264);
+	if (!decoder->codec)
+		return -1;
+	decoder->context = avcodec_alloc_context3(decoder->codec);
+	if (!decoder->context)
+		return -1;
+	decoder->context->flags2 |= AV_CODEC_FLAG2_FAST;
+	if (avcodec_open2(decoder->context, decoder->codec, NULL) < 0) {
+		avcodec_free_context(&decoder->context);
+		return -1;
+	}
+	decoder->using_hardware = false;
+	decoder->output_logged = false;
+	blog(LOG_INFO, "decoder selected: %s (software)", decoder->codec->name);
+	return 0;
+}
+
+static bool try_hardware_decoder(struct v4l2_decoder *decoder, const struct hardware_backend *backend)
+{
+	const AVCodec *codec = avcodec_find_decoder_by_name(backend->codec_name);
+	if (!codec)
+		return false;
+	bool supported = false;
+	for (int index = 0;; ++index) {
+		const AVCodecHWConfig *config = avcodec_get_hw_config(codec, index);
+		if (!config)
+			break;
+		if (config->device_type == backend->device_type && config->pix_fmt == backend->pixel_format &&
+		    (config->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX))
+			supported = true;
+	}
+	if (!supported)
+		return false;
+	AVCodecContext *context = avcodec_alloc_context3(codec);
+	if (!context)
+		return false;
+	int result = av_hwdevice_ctx_create(&context->hw_device_ctx, backend->device_type, NULL, NULL, 0);
+	if (result >= 0) {
+		decoder->hardware_format = backend->pixel_format;
+		context->opaque = decoder;
+		context->get_format = hardware_format;
+		result = avcodec_open2(context, codec, NULL);
+	}
+	if (result < 0) {
+		blog(LOG_DEBUG, "MJPEG backend %s/%s unavailable: %s", backend->codec_name,
+		     av_hwdevice_get_type_name(backend->device_type), av_err2str(result));
+		avcodec_free_context(&context);
+		return false;
+	}
+	decoder->context = context;
+	decoder->codec = codec;
+	decoder->using_hardware = true;
+	blog(LOG_INFO, "MJPEG decoder selected: %s (%s)", codec->name,
+	     av_hwdevice_get_type_name(backend->device_type));
+	return true;
+}
